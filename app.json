{
  "expo": {
    "name": "My Wallet",
    "slug": "my-wallet",
    "scheme": "mywallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "MY WALLET requires Face ID authentication to secure your financial records.",
        "NSContactsUsageDescription": "Allow MY WALLET to access your contacts to import people into Khata Book.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "n"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0284c7",
        "backgroundImage": "./assets/adaptive-icon-background.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_CONTACTS"
      ],
      "package": "com.naji_kallidumbil.mywallet"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to attach transaction bills and receipts.",
          "cameraPermission": "The app needs access to your camera to take transaction receipt photos."
        }
      ],
      "expo-document-picker",
      "expo-asset",
      "expo-status-bar",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow MY WALLET to use Face ID to authenticate you."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow MY WALLET to access your contacts to import people into Khata Book."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6e4dd0e2-c864-45d9-bd39-cbb9fbb750e6"
      },
      "supabaseUrl": "https://ruhifsmbgfhxoumfvoyl.supabase.co",
      "supabaseAnonKey": "sb_publishable_6DUz-G2y2Ggw103rtR83aQ_yhmWPDo_",
      "supabasePublishableKey": "sb_publishable_6DUz-G2y2Ggw103rtR83aQ_yhmWPDo_"
    }
  }
}
